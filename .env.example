# ------------------------------------------------------------
# Proyecto Astral — variables de entorno
# ------------------------------------------------------------
# Copia este archivo a `.env` y completa los valores con las claves
# de tu propio proyecto Supabase (Project Settings → API).
#
# NO subas `.env` al repositorio. Nunca pongas claves reales aquí.
# ------------------------------------------------------------

# URL pública del proyecto Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Clave publishable / anon (segura para exponer al cliente)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXX

# ID del proyecto (opcional, se usa en algunas integraciones)
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Solo servidor: clave con permisos elevados (Vercel → Environment Variables).
# NUNCA la expongas al cliente ni la prefijes con VITE_.
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Sistema de generación automática de horóscopos
# ------------------------------------------------------------

# DeepSeek API Key (obtener en: https://platform.deepseek.com)
# Solo servidor, NO prefijar con VITE_
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL de DeepSeek (opcional, usa default si no se especifica)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Modelo a usar (opcional, usa deepseek-chat por defecto)
# DEEPSEEK_MODEL=deepseek-chat

# Cron Secret: token de autorización para endpoints de cron
# Generar con: openssl rand -base64 32
# Solo servidor, NO prefijar con VITE_
CRON_SECRET=tu_token_secreto_super_seguro_aqui_generado_con_openssl

# ------------------------------------------------------------
# Proveedores IA alternativos (opcional)
# ------------------------------------------------------------

# Si quieres usar Lovable Gateway como fallback
# LOVABLE_API_KEY=

# Para forzar un proveedor específico (deepseek, lovable)
# AI_PROVIDER=deepseek
