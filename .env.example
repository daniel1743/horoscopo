# ------------------------------------------------------------
# Proyecto Astral — variables de entorno
# ------------------------------------------------------------
# Copia este archivo a `.env` y completa los valores con las claves
# de tu propio proyecto Supabase (Project Settings → API).
#
# NO subas `.env` al repositorio. Nunca pongas claves reales aquí.
# ------------------------------------------------------------

# URL pública del proyecto Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Clave publishable / anon (segura para exponer al cliente)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXX

# ID del proyecto (opcional, se usa en algunas integraciones)
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Solo servidor: clave con permisos elevados (Vercel → Environment Variables).
# NUNCA la expongas al cliente ni la prefijes con VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
